{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/graduation-credits/index.html"
    },
    {
      "source": "/graduation-credits",
      "destination": "/graduation-credits/index.html"
    },
    {
      "source": "/graduation-credits/",
      "destination": "/graduation-credits/index.html"
    },
    {
      "source": "/timetable",
      "destination": "/timetable/index.html"
    },
    {
      "source": "/timetable/",
      "destination": "/timetable/index.html"
    },
    {
      "source": "/connect",
      "destination": "/connect/index.html"
    },
    {
      "source": "/connect/",
      "destination": "/connect/index.html"
    },
    {
      "source": "/api/oauth/start",
      "destination": "/api/oauth?action=start"
    },
    {
      "source": "/api/oauth/callback",
      "destination": "/api/oauth?action=callback"
    },
    {
      "source": "/api/oauth/mint",
      "destination": "/api/oauth?action=mint"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PATCH, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        }
      ]
    }
  ]
}
